{
  "name": "evidence-action",
  "version": "1.1.0",
  "private": true,
  "description": "Timestamp and seal build artifacts with Sigill from GitHub Actions — only digests leave the runner.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "esbuild src/main.js --bundle --platform=node --target=node24 --format=esm --outfile=dist/index.js --banner:js=\"import{createRequire}from'module';const require=createRequire(import.meta.url);\"",
    "test": "node --test test/*.test.js"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@actions/core": "3.0.1",
    "@actions/glob": "0.7.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
